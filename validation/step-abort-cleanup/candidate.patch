+@pytest.mark.parametrize("during_step", [False, True])
+def test_background_abort_delivers_output_when_queue_becomes_idle(
+    monkeypatch: pytest.MonkeyPatch, during_step: bool
+) -> None:
+    engine = _make_engine()
+    request = _make_request("abort-idle")
+    engine.scheduler.add_request(request)
+    request_ids = {request.request_id}
+    engine.execution_mode = DiffusionExecutionMode.REQUEST_BATCH
+    engine.dp_concurrent = False
+    engine._rpc_queue = queue.Queue()
+    stop_event = threading.Event()
+    engine.stop_event = stop_event
+    outputs: list[DiffusionOutput] = []
+
+    def deliver(request_id: str, output: DiffusionOutput) -> None:
+        assert request_id in request_ids
+        assert output.aborted
+        outputs.append(output)
+        if len(outputs) == len(request_ids):
+            stop_event.set()
+
+    monkeypatch.setattr(engine, "_put_output", deliver)
+    if during_step:
+        waiting = _make_request("abort-waiting")
+        engine.scheduler.add_request(waiting)
+        request_ids.add(waiting.request_id)
+
+        def execute(schedule: DiffusionSchedulerOutput) -> RunnerOutput:
+            assert schedule.scheduled_request_ids == [request.request_id]
+            engine.abort(list(request_ids))
+            return RunnerOutput(request_id=request.request_id, step_index=1, finished=False)
+
+        engine.execute_fn = execute
+    else:
+        engine.abort([request.request_id, request.request_id, "unknown"])
+    thread = threading.Thread(target=engine._busy_loop, daemon=True)
+    thread.start()
+    try:
+        thread.join(timeout=5)
+    finally:
+        stop_event.set()
+        with engine._cv:
+            engine._cv.notify_all()
+        thread.join(timeout=5)
+
+    assert not thread.is_alive()
+    assert len(outputs) == len(request_ids)
+    assert all(engine.scheduler.get_request_state(request_id) is None for request_id in request_ids)
+
+
 def test_close_rejects_late_async_requests() -> None:
     engine = _make_engine()
     event_loop = asyncio.new_event_loop()
