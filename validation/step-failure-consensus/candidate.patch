+def _run_step_failure_consensus(rank: int, world_size: int, init_method: str) -> None:
+    from vllm_omni.diffusion.distributed import parallel_state
+    from vllm_omni.diffusion.distributed.group_coordinator import GroupCoordinator
+
+    torch.distributed.init_process_group(
+        "gloo", rank=rank, world_size=world_size, init_method=init_method, timeout=timedelta(seconds=30)
+    )
+    with pytest.MonkeyPatch.context() as monkeypatch:
+        monkeypatch.setattr(current_omni_platform, "get_torch_device", lambda _rank: torch.device("cpu"))
+        group = GroupCoordinator([list(range(world_size))], rank, "gloo")
+        monkeypatch.setattr(parallel_state, "_WORLD", group)
+        try:
+            assert not model_runner_module._dit_any_rank_failed(False)
+            for failed_rank in range(world_size):
+                assert model_runner_module._dit_any_rank_failed(rank == failed_rank)
+                assert not model_runner_module._dit_any_rank_failed(False)
+
+            runner = _make_runner()
+            original_prepare = runner.pipeline.prepare_encode
+
+            def prepare(state: StepRequestState) -> StepRequestState:
+                if state.request_id == "bad" and rank == world_size - 1:
+                    raise ValueError("rank-local preparation failure")
+                return original_prepare(state)
+
+            monkeypatch.setattr(runner.pipeline, "prepare_encode", prepare)
+            bad = StepRequestState("bad", OmniDiffusionSamplingParams())
+            good = StepRequestState("good", OmniDiffusionSamplingParams())
+            runner.state_cache = {state.request_id: state for state in (bad, good)}
+            prepared, batch, errors = runner._prepare_batch_inputs([bad, good], ["bad", "good"])
+            assert [state.request_id for state in prepared] == ["good"]
+            assert batch is not None and batch.request_ids == ["good"]
+            assert len(errors) == 1 and errors[0].request_id == "bad" and errors[0].finished
+            assert errors[0].result is not None and errors[0].result.error is not None
+            assert set(runner.state_cache) == {"good"}
+        finally:
+            group.destroy()
+            torch.distributed.destroy_process_group()
+
+
+@pytest.mark.cpu
+@pytest.mark.parametrize("world_size", [1, 2])
+def test_step_failure_consensus_gloo(tmp_path: Path, world_size: int) -> None:
+    torch.multiprocessing.spawn(
+        _run_step_failure_consensus,
+        args=(world_size, f"file://{tmp_path / 'rendezvous'}"),
+        nprocs=world_size,
+        join=True,
+    )
